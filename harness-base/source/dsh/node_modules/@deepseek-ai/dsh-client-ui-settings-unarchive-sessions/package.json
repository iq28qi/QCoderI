{
  "name": "@deepseek-ai/dsh-client-ui-settings-unarchive-sessions",
  "description": "Archived-session settings page: the registry-global archive set with one Unarchive action per row",
  "version": "0.1.0-rc.22",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-settings-unarchive-sessions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.0-rc.22",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.0-rc.22",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.22",
    "@deepseek-ai/dsh-client-test-runtime": "^0.1.0-rc.22",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.22",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.0-rc.22",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.0-rc.22",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.22",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.22",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.22",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.0-rc.22"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}